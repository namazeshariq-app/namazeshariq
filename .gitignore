# ==============================================================================
# .gitignore for Namaz-e-Shariq (Next.js & Cloudflare)
# Protects sensitive environment variables, caches, and heavy build artifacts
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store

# Next.js Build Output & Caches
.next/
out/
build/
dist/

# Cloudflare OpenNext & Wrangler Artifacts
.open-next/
.wrangler/
wrangler-*.log
.dev.vars

# Local Environment Variables & Secrets (CRITICAL: Do NOT upload to GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Vercel & Other Deployers
.vercel

# Debug & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript Build Info
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary scratch & one-off files
scripts/inspect_head.js
console.log*
