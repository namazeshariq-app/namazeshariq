13:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open w-5 h-5 text-brand-700 dark:text-emerald-400","children":[["$","path","1akyts",{"d":"M12 7v14"}],["$","path","ruj8y",{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"}],"$undefined"]}],"4. Juristic Differences (Ikhtilaf) & Multi-School Inclusivity"]}],["$","p",null,{"children":["Our platform explicitly facilitates calculations conforming to both the ",["$","strong",null,{"children":"Hanafi school"}]," (Asr shadow factor 2, as widely observed across Pakistan, India, Bangladesh, Turkey, and Central Asia) and the ",["$","strong",null,{"children":"Shafi’i, Maliki, and Hanbali schools"}]," (Asr shadow factor 1, as observed across Kerala, coastal Karnataka, Egypt, Southeast Asia, and the Arabian Peninsula)."]}],["$","p",null,{"children":"We honor legitimate scholarly differences (*Ikhtilaf*) as an authentic mercy within Islamic legal history. Users can toggle freely between calculation methods and schools within our live widget. The editorial board does not endorse sectarian exclusivism and provides verified citations for all presented rulings."}]]}]
