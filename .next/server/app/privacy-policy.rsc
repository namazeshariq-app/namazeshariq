ren":"bangalore"}]," or ",["$","code",null,{"children":"karachi"}],") locally in your own browser so the widget remembers your preferred schedule on repeat visits. You can clear this at any time in your browser settings."]}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":[["$","strong",null,{"children":["HTTP Cookie (",["$","code",null,{"children":"admin_session"}],"):"]}]," Only issued upon successful administrative login at ",["$","code",null,{"children":"/admin/login"}],". This cookie is marked ",["$","code",null,{"children":"HttpOnly"}],", ",["$","code",null,{"children":"Secure"}],", ",["$","code",null,{"children":"SameSite=Strict"}],", and is protected with a 24-hour expiration window signed using Jose JSON Web Tokens (JWT). Regular readers receive zero cookies."]}]]}]]}]]}]]}]
11:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe w-5 h-5 text-brand-700 dark:text-emerald-400","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","13o1zl",{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"}],["$","path","9i4pu4",{"d":"M2 12h20"}],"$undefined"]}],"5. Global Regulatory Compliance & Religious Rights"]}],["$","p",null,{"children":"Although Namaz-e-Shariq does not harvest personal profiles, our technical protocols conform rigorously with leading global data protection standards:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"General Data Protection Regulation (GDPR - Regulation EU 2016/679):"}]," We respect the lawful basis of consent and legitimate interest. Readers in the European Union have the right to request confirmation of any correspondence records, rectify erroneous submissions, or request permanent erasure without unreasonable delay."]}],["$","li",null,{"children":[["$","strong",null,{"children":"California Consumer Privacy Act (CCPA / CPRA):"}]," We affirm that Namaz-e-Shariq has never sold, rented, leased, or shared personal information of any user with third-party data brokers, ad networks, or commercial syndicates, and will never do so in the future."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Digital Personal Data Protection Act (DPDP Act - India):"}]," Because our platform serves hundreds of thousands of worshipers across Indian metropolises (Bangalore, Delhi, Mumbai, Chennai, Calicut, Kochi, Hyderabad, and Kolkata), we observe the fiduciary principles outlined in the DPDP Act, ensuring that communication records are retained solely for legitimate editorial resolution."]}]]}]]}]
12:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-shield-check w-5 h-5 text-brand-700 dark:text-emerald-400","children":[["$","path","oel41y",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],"6. Cryptographic Security Standards & Edge Defense"]}],["$","p",null,{"children":"Security is not an optional feature; it is fundamental to preserving the authenticity of prayer schedules and religious scholarship. We enforce an extensive multi-layer defense posture:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Strict Transport Security (HSTS):"}]," All network connections are enforced over HTTPS utilizing TLS 1.3 encryption with a ",["$","code",null,{"children":"max-age=63072000; includeSubDomains; preload"}]," header to prevent man-in-the-middle tampering."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Content Security Policy (CSP):"}]," Prevents unauthorized script injection, malicious frame hijacking, and Cross-Site Scripting (XSS) vectors."]}],["$","li",null,{"children":[["$","strong",null,{"children":"PBKDF2 / SHA-256 Password Cryptography:"}]," Editorial credentials undergo 100,000 iterations of Password-Based Key Derivation Function 2 with unique cryptographic salts generated via Web Crypto API."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Cloudflare DDoS & Bot Shielding:"}]," Continuous edge inspection mitigates distributed denial of service attempts, scrapers, and brute-force authentication attacks."]}]]}]]}]
