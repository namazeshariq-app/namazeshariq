b:["$","div",null,{"className":"bg-white dark:bg-slate-900 p-8 sm:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xs space-y-8 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed","children":[["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-compass w-5 h-5 text-brand-700 dark:text-emerald-400","children":[["$","path","9ktpf1",{"d":"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"}],["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],"$undefined"]}],"1. The Sacred Concept of Amanah in Digital Governance"]}],["$","p",null,{"children":["In Islamic moral theology, every form of responsibility entrusted by human beings to another constitutes an ",["$","em",null,{"children":"Amanah"}]," (a sacred divine trust). In Surah Al-Anfal (8:27), Allah Almighty instructs: ",["$","em",null,{"children":"“O you who have believed, do not betray Allah and the Messenger or betray your trusts while you know [the consequence].”"}]," At Namaz-e-Shariq, we treat personal privacy not as a commercial afterthought or mere regulatory burden, but as a binding spiritual obligation."]}],["$","p",null,{"children":"Unlike conventional online portals that monetize religious devotion by harvesting user identities, selling telemetry to advertising brokers, or deploying cross-site tracking beacons, Namaz-e-Shariq was engineered from the ground up on principles of data minimization. We hold that a believer seeking the sacred times of prayer, researching daily namaz rakats, or purifying their heart through Islamic educational guides should do so in an environment of total confidentiality, dignity, and digital sanctuary."}]]}],["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-server w-5 h-5 text-brand-700 dark:text-emerald-400","children":[["$","rect","ngkwjq",{"width":"20","height":"8","x":"2","y":"2","rx":"2","ry":"2"}],["$","rect","iecqi9",{"width":"20","height":"8","x":"2","y":"14","rx":"2","ry":"2"}],["$","line","16zg32",{"x1":"6","x2":"6.01","y1":"6","y2":"6"}],["$","line","nzw8ys",{"x1":"6","x2":"6.01","y1":"18","y2":"18"}],"$undefined"]}],"2. Edge Architecture & Zero-Knowledge Computational Model"]}],["$","p",null,{"children":"Our website is hosted on Cloudflare Pages and executes logic across Cloudflare’s globally distributed Edge network. This architectural paradigm allows mathematical solar coordinate formulas (including Julian day tracking, solar declination, and equation of time) to be computed in serverless micro-environments nearest to the user without writing personal access histories to centralized server disks."}],["$","p",null,{"children":"When you load prayer times for Bangalore, Delhi, Karachi, Dhaka, Dubai, London, or New York, the calculation is evaluated in memory or pre-rendered as immutable Static Site Generated (SSG) HTML. Our Cloudflare D1 distributed database stores only verified article content, category taxonomies, administrative authentication hashes, and site configuration settings. It maintains zero tables for visitor profiles, tracking pixels, or cross-session user behavior profiling."}]]}],"$Lf","$L10","$L11","$L12","$L13","$L14"]}]
