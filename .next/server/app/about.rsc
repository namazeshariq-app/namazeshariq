7:["$","div",null,{"className":"bg-slate-50 dark:bg-slate-950 min-h-screen py-12 transition-colors duration-200","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"AboutPage\",\"name\":\"About Namaz-e-Shariq\",\"description\":\"Learn about Namaz-e-Shariq, our commitment to authentic Islamic scholarship, edge-calculated solar prayer times, and rigorous Fiqh verification.\",\"url\":\"https://namazeshariq.com/about\",\"mainEntity\":{\"@type\":\"Organization\",\"name\":\"Namaz-e-Shariq\",\"url\":\"https://namazeshariq.com\",\"logo\":\"https://namazeshariq.com/logo.png\",\"knowsAbout\":[\"Islamic Prayer Times\",\"Daily Namaz Rakats\",\"Salah Rulings\",\"Spherical Solar Astronomy\",\"Hanafi Jurisprudence\",\"Shafi’i Jurisprudence\",\"Qiblah Coordinates\"]}}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10","children":[["$","div",null,{"className":"text-center max-w-2xl mx-auto","children":[["$","div",null,{"className":"w-16 h-16 rounded-2xl bg-brand-800 text-emerald-300 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-brand-900/10","children":["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-compass w-8 h-8","children":[["$","path","9ktpf1",{"d":"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"}],["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],"$undefined"]}]}],["$","h1",null,{"className":"text-3xl sm:text-5xl font-black text-slate-900 dark:text-slate-100 tracking-tight","children":"About Namaz-e-Shariq"}],["$","p",null,{"className":"mt-3 text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed","children":"Uniting classical Islamic jurisprudence with modern celestial coordinate science to serve the global Ummah with verified, authentic prayer resources."}]]}],["$","div",null,{"className":"bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xs space-y-6 transition-colors duration-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900 dark:text-slate-100","children":"Our Sacred Mission and Founding Vision"}],["$","p",null,{"className":"text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed","children":"Salah (Namaz) stands as the second pillar of Islam and the spiritual axis around which every believer’s daily life revolves. From the peaceful serenity of the pre-dawn hours to the tranquil stillness of the night, prayer creates a structured rhythm that anchors the human soul to its Creator. In our increasingly interconnected modern era, where Muslims travel across continents, work flexible corporate schedules, and live in diverse global diaspora hubs, access to verified, scientifically precise, and jurisprudentially sound prayer timetables is an indispensable necessity."}],["$","p",null,{"className":"text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed","children":[["$","strong",null,{"children":"Namaz-e-Shariq"}]," was established with a singular objective: to eradicate ambiguity in prayer times, eliminate reliance on third-party APIs that suffer from downtime or rate limitations, and provide humanized, deeply researched educational literature that bridges classical Fiqh manuals with modern solar mechanics. Every calculation rendered on our portal is computed directly on Cloudflare Edge using pure spherical astronomy algorithms, ensuring sub-second response times worldwide without selling user data or relying on invasive tracking cookies."]}],"$Lb"]}],"$Lc","$Ld","$Le","$Lf"]}]]}]
