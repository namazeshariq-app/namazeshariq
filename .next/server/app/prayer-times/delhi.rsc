22:["$","div",null,{"className":"p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":["Isha & Tahajjud (","7:06 PM"," to ","1:20 AM",")"]}],["$","p",null,{"className":"leading-relaxed","children":["Isha begins when evening twilight has completely dissipated. The late third of the night (Qiyam al-Layl / Tahajjud starting at ","1:20 AM",") is the most spiritually elevated time for voluntary prayer and intimate supplication (*Munajat*)."]}]]}]
