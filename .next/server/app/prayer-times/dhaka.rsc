23:["$","div",null,{"className":"p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":["Maghrib (Sunset / Iftar at ","5:25 PM",")"]}],["$","p",null,{"className":"leading-relaxed","children":"Maghrib begins the instant the entire solar disk vanishes beneath the western horizon. Fasting believers break their fast at this moment with dates and water. Maghrib has the shortest window of all prayers; performing it promptly is a strongly emphasized Sunnah."}]]}]
24:["$","div",null,{"className":"p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":["Isha & Tahajjud (","6:41 PM"," to ","12:58 AM",")"]}],["$","p",null,{"className":"leading-relaxed","children":["Isha begins when evening twilight has completely dissipated. The late third of the night (Qiyam al-Layl / Tahajjud starting at ","12:58 AM",") is the most spiritually elevated time for voluntary prayer and intimate supplication (*Munajat*)."]}]]}]
25:["$","section",null,{"className":"space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800","children":[["$","h3",null,{"className":"text-xl font-bold text-slate-900 dark:text-slate-100","children":["2. Traveler (Musafir) Rulings for Visitors Arriving in ","Dhaka"]}],["$","p",null,{"className":"text-slate-700 dark:text-slate-300 text-sm leading-relaxed","children":["If you are traveling to ","Dhaka"," from another city or country and your intended stay is less than 15 consecutive days, you are classified in Islamic law as a *Musafir* (traveler):"]}],["$","ul",null,{"className":"list-disc pl-6 space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400","children":[["$","li",null,{"children":"You shorten 4-rakat Fard prayers (Dhuhr, Asr, Isha) to 2 rakats (*Qasr*). Fajr and Maghrib are never shortened."}],["$","li",null,{"children":["When praying behind a resident Imam in a local mosque in ","Dhaka",", you follow the Imam and complete the full 4 rakats without shortening."]}],["$","li",null,{"children":"You may wipe over leather socks (*Khuffayn*) or waterproof ablution socks for up to 72 hours (3 days and nights) instead of washing your feet during Wudu."}]]}]]}]
26:["$","section",null,{"className":"space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800","children":[["$","h3",null,{"className":"text-xl font-bold text-slate-900 dark:text-slate-100","children":"3. Mosque Jamat Assembly Times & Etiquette"}],["$","p",null,{"className":"text-slate-700 dark:text-slate-300 text-sm leading-relaxed","children":["Most neighborhood masajid across ","Dhaka"," ring the Azan at the entry of the waqt displayed above, and assemble the congregation (Iqamah) roughly 15 to 25 minutes later. When visiting local houses of worship, maintain quiet reverence, turn mobile devices to silent mode, and perform two rakats of *Tahiyyat al-Masjid* upon entering before sitting down."]}],false,false,["$","div",null,{"className":"p-4 rounded-xl bg-brand-50/70 dark:bg-emerald-950/30 border border-brand-200 dark:border-emerald-800/60 space-y-1.5 text-xs text-slate-700 dark:text-slate-300","children":[["$","h4",null,{"className":"font-bold text-brand-900 dark:text-emerald-300 text-sm","children":"Dhaka Tahajjud & Islamic Foundation Bangladesh Guidelines:"}],["$","p",null,{"children":["The optimal ",["$","strong",null,{"children":"tahajjud namaz time dhaka"}]," occurs during the final third of the night between Isha and morning twilight. In Dhaka, Tahajjud vigil and Sehri concludes sharply at Subh Sadiq, aligned with Islamic Foundation Bangladesh criteria."]}]]}],false,false,["$","div",null,{"className":"pt-2 flex flex-wrap gap-4 text-xs font-semibold text-brand-700 dark:text-emerald-400","children":[["$","$L17",null,{"href":"/rakats","className":"hover:underline flex items-center gap-1","children":[["$","span",null,{"children":"View Complete Namaz Rakats Guide"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}],["$","$L17",null,{"href":"/blog/understanding-namaz-timings-calculation-methods","className":"hover:underline flex items-center gap-1","children":[["$","span",null,{"children":"How Solar Angles Are Calculated"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}]]}]]}]
