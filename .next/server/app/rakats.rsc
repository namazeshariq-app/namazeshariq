00 dark:text-emerald-300 text-base flex items-center gap-2","children":[["$","span",null,{"className":"w-2.5 h-2.5 rounded-full bg-emerald-600"}],"6 Shuroot (Conditions Before Namaz)"]}],["$","ol",null,{"className":"list-decimal pl-5 space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Taharah (Purification):"}]," Cleanliness of body, clothes, and place of prayer from minor (*Hadath Asghar*) and major impurity (*Hadath Akbar*)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Satr-e-Awrah (Covering):"}]," Men covering from navel to below knees; women covering entire body except face, hands to wrists, and feet (see Namaz Chadar guide below)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Istiqbal-e-Qibla:"}]," Facing the precise direction of the Holy Ka’bah in Makkah."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Waqt (Correct Time):"}]," Ensuring the prescribed prayer interval has entered."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Niyyah (Intention):"}]," Sincere internal resolve in the heart for the specific prayer being offered."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Takbeer-e-Tahrimah:"}]," Saying ",["$","em",null,{"children":"“Allahu Akbar”"}]," to enter the sacred state of prayer."]}]]}]]}],["$","div",null,{"className":"p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-3","children":[["$","h3",null,{"className":"font-bold text-brand-900 dark:text-emerald-300 text-base flex items-center gap-2","children":[["$","span",null,{"className":"w-2.5 h-2.5 rounded-full bg-emerald-600"}],"7 Arkan (Pillars Inside Namaz)"]}],["$","ol",null,{"className":"list-decimal pl-5 space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300","children":[["$","li",null,{"children":["$L26"," Standing upright if physically able in Fard prayers."]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]]}]]}]
