1c:["$","p",null,{"className":"text-slate-600 dark:text-slate-300 leading-relaxed","children":"South Asian masajid follow the Karachi 18°/18° standard, whereas Arabian Peninsula masajid observe the Umm Al-Qura 18.5° standard. Ensure you have selected the appropriate calculation methodology corresponding to your region."}]
1d:["$","div",null,{"className":"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":"Hanafi vs. Shafi’i Asr Factor"}],["$","p",null,{"className":"text-slate-600 dark:text-slate-300 leading-relaxed","children":"In Hanafi jurisprudence, Asr starts when an object’s shadow equals twice its length plus midday shadow (Factor 2), approximately 45 to 60 minutes after the Shafi’i/Maliki/Hanbali earlier time (Factor 1). Use our widget toggle to verify both calculations."}]]}]
1e:["$","div",null,{"className":"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":"Elevation Above Sea Level"}],["$","p",null,{"className":"text-slate-600 dark:text-slate-300 leading-relaxed","children":"Cities situated at high altitudes (such as Bangalore at 920 meters or Quetta at 1,680 meters) experience sunrise slightly earlier and sunset slightly later than sea-level locations on the same latitude due to the geometric dip of the horizon."}]]}]
1f:["$","div",null,{"className":"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60","children":[["$","span",null,{"className":"font-bold text-slate-900 dark:text-slate-100 block text-sm mb-1","children":"Standard Sunnah Precaution (Ihtiyat)"}],["$","p",null,{"className":"text-slate-600 dark:text-slate-300 leading-relaxed","children":"Traditional printed calendars generally add a safety buffer of 2 to 3 minutes after mathematical sunset for Maghrib, and deduct 5 minutes from Fajr start for Sehri conclusion. Our calculations explicitly document both the raw astronomical coordinates and standard precautionary windows."}]]}]
20:["$","section",null,{"className":"space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800","children":[["$","h3",null,{"className":"text-lg font-bold text-slate-900 dark:text-slate-100","children":"3. Scholarly Peer Review and Academic Contributions"}],["$","p",null,{"className":"text-slate-600 dark:text-slate-300 text-sm leading-relaxed","children":"We welcome scholars, researchers in Islamic celestial astronomy (*Ilm al-Falak*), and certified Muftis who wish to contribute scholarly articles or peer-review existing guides on our platform. All contributors must provide their academic credentials (e.g., Alimiyyah or Takhassus degrees from recognized Darul Ulooms or universities) and cite classical Fiqh references (*Kutub al-Turath*) in any submitted manuscripts."}]]}]
21:["$","section",null,{"className":"space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800","children":[["$","h3",null,{"className":"text-lg font-bold text-slate-900 dark:text-slate-100","children":"4. Corporate Prayer Accommodations and Workplace Advocacy"}],["$","p",null,{"className":"text-slate-600 dark:text-slate-300 text-sm leading-relaxed","children":"A substantial portion of user correspondence involves professionals seeking guidance on negotiating clean, private prayer spaces and reasonable prayer breaks within multinational corporate environments, healthcare facilities, and academic institutions. Our team provides verified documentation, legal precedent summaries, and scheduling templates designed to assist employees and students in obtaining respectful accommodations for daily Dhuhr and Friday Jumu’ah assemblies."}]]}]
