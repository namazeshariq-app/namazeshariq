14:T7c7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How are today namaz timings calculated on this website?","acceptedAnswer":{"@type":"Answer","text":"Our calculation engine utilizes astronomical solar coordinates algorithms (tracking Julian day, solar declination, and equation of time) combined with established juristic twilight depression angles (such as the 18°/18° standard mandated by the University of Islamic Sciences Karachi and Muslim World League). All times run directly on edge servers with verified astronomical standards."}},{"@type":"Question","name":"How do I know how many rakats to pray for each daily namaz?","acceptedAnswer":{"@type":"Answer","text":"Daily prayers total 17 obligatory (Fard) rakats plus 12 Sunnah Mu’akkadah and the 3 Witr prayer: Fajr (2 Sunnah, 2 Fard = 4), Dhuhr (4 Sunnah, 4 Fard, 2 Sunnah, 2 Nafl = 12), Asr (4 Sunnah, 4 Fard = 8), Maghrib (3 Fard, 2 Sunnah, 2 Nafl = 7), and Isha (4 Sunnah, 4 Fard, 2 Sunnah, 2 Nafl, 3 Witr, 2 Nafl = 17)."}},{"@type":"Question","name":"What is the difference between Hanafi and Shafi’i Asr prayer time?","acceptedAnswer":{"@type":"Answer","text":"The difference lies in the shadow length factor used to define the entry of Asr. The Shafi’i, Maliki, and Hanbali schools state Asr begins when an object’s shadow equals its length plus midday shadow (Factor 1). The Hanafi school states Asr begins when the shadow reaches twice the object’s length plus midday shadow (Factor 2), approximately 45 to 60 minutes later."}},{"@type":"Question","name":"What is \"Fajr last time\" and can I pray during sunrise?","acceptedAnswer":{"@type":"Answer","text":"Fajr waqt expires the exact moment the edge of the sun crosses above the horizon (Shurooq / Sunrise). Offering prayer during sunrise is strictly prohibited (Makruh Tahrimi). Once the sun has fully risen about a spear’s length (15 to 20 minutes after sunrise), one may offer Ishraq or make up missed Fajr."}}]}7:["$","div",null,{"className":"space-y-16 pb-20","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$14"}}],["$","section",null,{"className":"relative overflow-hidden pt-6 pb-12 sm:pt-12 sm:pb-16 md:pt-14 md:pb-18 lg:pt-16 lg:pb-20 border-b border-slate-200 dark:border-slate-800 transition-colors duration-200","children":[["$","div",null,{"className":"absolute inset-0 z-0 overflow-hidden","children":[["$","img",null,{"src":"/images/namaz-banner.jpg","alt":"Muslim Worshippers Performing Congregational Namaz (Prayer in Jamat) in Mosque","className":"w-full h-full object-cover object-[center_28%] sm:object-[center_35%] opacity-85 dark:opacity-65 transition-opacity duration-300 scale-100 sm:scale-105 filter brightness-95 contrast-105"}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-b from-white/35 via-white/15 to-slate-50/90 dark:from-slate-950/50 dark:via-slate-950/30 dark:to-slate-950/90"}]]}],["$","$L15",null,{}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"text-center max-w-4xl mx-auto mb-8 sm:mb-12 bg-white/70 dark:bg-slate-950/70 backdrop-blur-md p-6 sm:p-8 md:p-10 rounded-3xl border border-white/60 dark:border-white/10 shadow-lg shadow-black/5","children":[["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-100/95 dark:bg-emerald-950/80 text-emerald-900 dark:text-emerald-300 border border-emerald-300/80 dark:border-emerald-700/60 mb-4 sm:mb-5 shadow-xs","children":["$L16","$L17"]}],"$L18","$L19"]}],"$L1a"]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}]
