","children":"Theological Advisory, Astronomical Precision & Legal Disclaimer"}],["$","p",null,{"className":"mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed","children":"*Bismillahir Rahmanir Raheem* — In the name of Allah, the Most Gracious, the Most Merciful. This document sets forth the theological parameters, scientific methodologies, precautions (*Ihtiyat*), and terms governing the use of Namaz-e-Shariq."}],["$","div",null,{"className":"flex flex-wrap items-center gap-4 mt-4 text-xs text-slate-500 dark:text-slate-400","children":[["$","span",null,{"children":"Effective Date: October 2026"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"Reviewed by Scholarly Advisory Board"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"Juristic Standard: Universal Islamic Consensus"}]]}]]}],["$","div",null,{"className":"prose-custom space-y-8 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed","children":[["$","section",null,{"className":"bg-emerald-50/60 dark:bg-emerald-950/20 rounded-2xl p-6 border border-emerald-200 dark:border-emerald-800/60","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-heart-handshake w-6 h-6 text-emerald-700 dark:text-emerald-400 shrink-0 mt-0.5","children":[["$","path","c3ymky",{"d":"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"}],["$","path","4oyue0",{"d":"M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"}],["$","path","60u0ii",{"d":"m18 15-2-2"}],["$","path","6p76be",{"d":"m15 18-2-2"}],"$undefined"]}],["$","div",null,{"children":[["$","h2",null,{"